{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/forge.mjs\" hook session-start",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell",
        "command": "node \"${PLUGIN_ROOT}/scripts/forge.mjs\" hook pre-tool",
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/forge.mjs\" hook session-end",
        "timeoutSec": 10
      }
    ]
  }
}
