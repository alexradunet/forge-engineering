{
  "name": "github",
  "title": "GitHub",
  "description": "Generic GitHub profile: GitHub Issues, GitHub pull requests, and GitHub Actions, all with the gh CLI.",
  "files": [
    "plugin.json"
  ],
  "tests": [],
  "terms": [],
  "tools": [
    "gh"
  ],
  "mainCheckout": null,
  "mcpServers": [],
  "mcpRetired": [],
  "never": [
    { "words": ["gh", "pr", "merge"], "verdict": "deny" },
    { "words": ["gh", "pr", "review"], "with": ["--approve", "-a"], "verdict": "deny" },
    { "words": ["gh", "pr", "close"], "verdict": "ask" }
  ],
  "bodyOptions": [
    "-F",
    "--body-file"
  ]
}
